# ===== Required for Supabase (production) =====
# Without real values the app runs in labelled demo mode. Placeholder strings
# (for example "your-anon-key") are intentionally ignored.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to "true" only when using a verified custom Supabase domain.
SUPABASE_URL_ALLOW_CUSTOM=false

# ===== Site =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NPL Cricket Hub

# ===== Auth (demo mode only) =====
# 32+ random characters. Used to sign the demo session cookie.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@nplcrickethub.local
ADMIN_PASSWORD=demo-admin-password
EDITOR_EMAIL=editor@nplcrickethub.local
EDITOR_PASSWORD=demo-editor-password
FAN_EMAIL=fan@nplcrickethub.local
FAN_PASSWORD=demo-fan-password

# ===== Integrations (optional, none required) =====
CRICKET_PROVIDER=none
CRICKET_PROVIDER_API_KEY=
CRICKET_PROVIDER_BASE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
